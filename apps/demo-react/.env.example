# OwlLayer React Demo Configuration
# Leave empty to use the browser's current host through the Vite WebSocket proxy.
# Set an explicit ws:// or wss:// URL only when the OwlLayer server is hosted elsewhere.
VITE_OWLLAYER_ENDPOINT=
VITE_OWLLAYER_API_KEY=pk_demo_local
VITE_APP_LANGUAGE=en
VITE_USE_DEFAULT_WIDGET=false
