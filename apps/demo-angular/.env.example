# ═══════════════════════════════════════════════════════
# OwlLayer Angular Marketplace Demo — Variables d'environnement (exemple)
# ═══════════════════════════════════════════════════════
# 
# Copiez ce fichier vers .env et renseignez vos valeurs

# Endpoint WebSocket du serveur OwlLayer
VITE_OWLLAYER_ENDPOINT=ws://localhost:4001/owllayer

# Clé API OwlLayer (publique, préfixée pk_)
# Créez votre propre clé via le dashboard admin OwlLayer
VITE_OWLLAYER_API_KEY=pk_78ab37_angular_marketplace

# Utiliser le widget par défaut
VITE_USE_DEFAULT_WIDGET=true

# URL de base de l'API admin OwlLayer (optionnel)
VITE_ADMIN_API_BASE_URL=http://localhost:4001
