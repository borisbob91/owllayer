# ═══════════════════════════════════════════════════════
# DomOS Angular Marketplace Demo — Variables d'environnement (exemple)
# ═══════════════════════════════════════════════════════
# 
# Copiez ce fichier vers .env et renseignez vos valeurs

# Endpoint WebSocket du serveur DomOS
VITE_DOMOS_ENDPOINT=ws://localhost:4001/domos

# Clé API DomOS (publique, préfixée pk_)
# Créez votre propre clé via le dashboard admin DomOS
VITE_DOMOS_API_KEY=pk_78ab37_angular_marketplace

# Utiliser le widget par défaut
VITE_USE_DEFAULT_WIDGET=true

# URL de base de l'API admin DomOS (optionnel)
VITE_ADMIN_API_BASE_URL=http://localhost:4001
