# --- Core ---
PORT=3002

# --- Google Gemini (LLM texte + Gemini Live via LiveKit) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- OwlLayer client auth ---
OWLLAYER_API_KEY=pk_livekit_demo

# --- LiveKit (serveur de media WebRTC) ---
# Doivent correspondre aux cles du serveur LiveKit (livekit.yaml ou LiveKit Cloud).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret

# Origines autorisees a demander un token de room.
OWLLAYER_LIVEKIT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
