# DeepSeek demo — copy this file to .env.deepseek, then: pnpm --filter @owllayer/demo-server dev:deepseek
# Values here override apps/demo-server/.env (shared settings: API keys, admin, ports...).
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false
LLM_TIMEOUT_MS=90000

# DeepSeek is text only. Optional: set a Google key to enable voice through
# Google STT/TTS (hybrid mode): speech -> text -> DeepSeek -> speech.
# GOOGLE_API_KEY=your_gemini_api_key_here
