# Google demo server: pnpm --filter @owllayer/demo-server dev:google
# Copy to .env.google. Text with Gemini, voice with Gemini Live (Google STT/TTS as hybrid pipeline).
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional, catalog defaults otherwise (GOOGLE_TEXT_MODELS, GOOGLE_LIVE_MODELS, GEMINI_VOICES)
GEMINI_MODEL=gemini-3.6-flash
# gemini-2.5-flash-native-audio-preview-12-2025 (default) takes the tools of each new page;
# gemini-3.8-live keeps the tools of the page where the voice started
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Fenrir
