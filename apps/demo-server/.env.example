# OwlLayer demo server: shared settings, read by every provider server.
# One server per provider, each with its own file (copy the matching .env.<provider>.example):
#   pnpm --filter @owllayer/demo-server dev:google     -> .env.google
#   pnpm --filter @owllayer/demo-server dev:openai     -> .env.openai
#   pnpm --filter @owllayer/demo-server dev:deepseek   -> .env.deepseek
#   pnpm --filter @owllayer/demo-server dev:deepgram   -> .env.deepgram (+ the file of its text LLM)
# A provider file overrides this one. `pnpm dev` starts DEMO_PROVIDER.
DEMO_PROVIDER=google

PORT=4001
LOG_LEVEL=info
DEFAULT_LANGUAGE=en

OWLLAYER_REQUIRE_API_KEY=true
OWLLAYER_API_KEY=pk_demo_local
OWLLAYER_ADMIN_API_KEY=pk_78ab37_vue_admin
OWLLAYER_TRAVEL_API_KEY=pk_78ab37_svelte_travel
OWLLAYER_ANGULAR_API_KEY=pk_78ab37_angular_marketplace
OWLLAYER_BROWSER_API_KEY=pk_browser_demo

ADMIN_USERNAME=admin
# Obligatoire pour activer l'admin et le dashboard : 12 caracteres minimum, jamais une valeur d'exemple
ADMIN_PASSWORD=
ADMIN_EXPOSE_API_KEYS=true

OWLLAYER_LIVEKIT_ALLOWED_ORIGINS=http://localhost:4100,http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4305
