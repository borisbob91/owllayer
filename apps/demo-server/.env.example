PORT=4001
OWLLAYER_PORT=4001
LOG_LEVEL=info

GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
DEFAULT_LANGUAGE=en

OWLLAYER_REQUIRE_API_KEY=true
OWLLAYER_API_KEY=pk_demo_local
OWLLAYER_ADMIN_API_KEY=pk_78ab37_vue_admin
OWLLAYER_TRAVEL_API_KEY=pk_78ab37_svelte_travel
OWLLAYER_ANGULAR_API_KEY=pk_78ab37_angular_marketplace
OWLLAYER_BROWSER_API_KEY=pk_browser_demo

ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ADMIN_EXPOSE_API_KEYS=true

OWLLAYER_LIVEKIT_ALLOWED_ORIGINS=http://localhost:4100,http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4305

# LLM provider: google (default) | openai | deepseek
LLM_PROVIDER=google
LLM_TIMEOUT_MS=90000

# OpenAI (LLM_PROVIDER=openai): text + Realtime voice
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
