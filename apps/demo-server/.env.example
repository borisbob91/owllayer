PORT=4001
OWLLAYER_PORT=4001
LOG_LEVEL=info

GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DEFAULT_LANGUAGE=en

OWLLAYER_REQUIRE_API_KEY=true
OWLLAYER_API_KEY=your_demo_api_key
OWLLAYER_ADMIN_API_KEY=your_vue_demo_api_key
OWLLAYER_TRAVEL_API_KEY=your_svelte_demo_api_key
OWLLAYER_ANGULAR_API_KEY=your_angular_demo_api_key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
ADMIN_EXPOSE_API_KEYS=true

OWLLAYER_LIVEKIT_ALLOWED_ORIGINS=http://localhost:4100,http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4305
