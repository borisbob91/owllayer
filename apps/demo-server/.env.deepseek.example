# DeepSeek demo server: pnpm --filter @owllayer/demo-server dev:deepseek
# Copy to .env.deepseek. DeepSeek is text only; for voice, run dev:deepgram with DEEPGRAM_TEXT_PROVIDER=deepseek.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false
LLM_TIMEOUT_MS=90000
