# Deepgram demo server: pnpm --filter @owllayer/demo-server dev:deepgram
# Copy to .env.deepgram. Voice with Deepgram; typed text with DEEPGRAM_TEXT_PROVIDER.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Voice mode, one at a time:
#   realtime (default): Deepgram Voice Agent, listening + reasoning + voice all billed by Deepgram
#   pipeline-streaming: Flux STT + the text LLM + Aura streaming
#   pipeline-batch: Nova STT + the text LLM + Aura
VOICE_MODE=realtime
# Realtime only, optional: reasoning model managed by Deepgram (open_ai | anthropic | google | nvidia)
DEEPGRAM_THINK_PROVIDER=
DEEPGRAM_THINK_MODEL=

# Text LLM for typed messages (and for the pipeline modes): deepseek | openai | google.
# Its key is read from its own file (.env.deepseek, .env.openai or .env.google).
DEEPGRAM_TEXT_PROVIDER=deepseek
