{
  email {$ACME_EMAIL}
  admin off
}

{$DOMOS_DOMAIN:localhost} {
  encode zstd gzip

  reverse_proxy server:4001 {
    transport http {
      keepalive 2m
    }
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }

  log {
    output stdout
    format json
  }
}
