# ============================================================
# DomOS deployment stack — environment variables
# Copy to .env and fill in real values before `docker compose up`.
# ============================================================

# --- Google Gemini (LLM + native audio + STT/TTS) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- DomOS client / admin auth ---
DOMOS_API_KEY=pk_demo_local
DOMOS_ADMIN_API_KEY=pk_admin_local
DOMOS_HOME_API_KEY=pk_home_local
DOMOS_REQUIRE_API_KEY=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- LiveKit (self-hosted) ---
# These MUST match the keys block in livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret

# Comma-separated list of origins allowed to request LiveKit room tokens.
DOMOS_LIVEKIT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
