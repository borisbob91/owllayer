# Image et exposition locale
DOMOS_IMAGE_TAG=local
DOMOS_PORT=4001
DOMOS_REQUIRE_API_KEY=true

# Domaine public du serveur DomOS, sans https://
DOMOS_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Origines web autorisees a demander un token LiveKit
DOMOS_LIVEKIT_ALLOWED_ORIGINS=https://app.example.com

# LiveKit Cloud ou instance self-hosted, secrets serveur uniquement
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Provider realtime actuellement implemente
GOOGLE_API_KEY=

# Administration DomOS
ADMIN_PASSWORD=
