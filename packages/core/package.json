{
  "name": "@owllayer/core",
  "version": "0.2.0",
  "description": "OwlLayer AI Core - AITP protocol, types, and ToolRegistry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./media/audio": {
      "import": "./dist/media/audio/index.js",
      "types": "./dist/media/audio/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/media/audio/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "opusscript": "^0.1.1",
    "wav-decoder": "^1.3.0",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
