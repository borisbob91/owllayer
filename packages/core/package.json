{
  "name": "@domos/core",
  "version": "0.1.0",
  "description": "DomOS Core - Protocole ADTP, Types, ToolRegistry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "webrtc": "^1.0.1",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/core"
  }
}
