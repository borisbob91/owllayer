{
  "name": "@owllayer/angular",
  "version": "0.3.0",
  "description": "OwlLayer Angular SDK - Provider et facade minimale pour OwlLayerClient",
  "type": "module",
  "main": "./dist/public-api.js",
  "types": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "import": "./dist/public-api.js",
      "types": "./dist/public-api.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/public-api.ts --format esm --dts --clean --external @angular/core --external @angular/common --external @angular/forms --external @owllayer/core --external @owllayer/core/media/audio --external @owllayer/ui --external @owllayer/ui --external zod",
    "test": "vitest run"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@angular/common": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "rxjs": ">=7.8.0"
  },
  "devDependencies": {
    "@owllayer/ui": "workspace:*",
    "@angular/core": "^20.3.32",
    "@angular/common": "^20.3.32",
    "@angular/forms": "^20.3.32",
    "@angular/compiler": "^20.3.32",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "owllayer",
    "angular",
    "angular-sdk",
    "agentic-ui",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "webmcp",
    "native-mcp",
    "tool-calling",
    "frontend-ai",
    "livekit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
