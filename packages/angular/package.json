{
  "name": "@domos/angular",
  "version": "0.1.1",
  "description": "DomOS Angular SDK - Provider et facade minimale pour DomOSClient",
  "type": "module",
  "main": "./dist/public-api.js",
  "types": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "import": "./dist/public-api.js",
      "types": "./dist/public-api.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/public-api.ts --format esm --dts --clean --external @angular/core --external @angular/common --external @angular/forms --external @domos/core --external @owllayer/core/media/audio --external @domos/ui --external zod",
    "test": "vitest run"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^",
    "@domos/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@angular/common": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "rxjs": ">=7.8.0"
  },
  "devDependencies": {
    "@angular/core": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/domos/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
