{
  "name": "@domos/ui",
  "version": "0.1.1",
  "description": "DomOS UI — Dashboard embarqué et DevTools cross-framework",
  "type": "module",
  "main": "./dist/ui.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ui.esm.js",
      "types": "./dist/index.d.ts"
    },
    "./dashboard": {
      "import": "./dist/dashboard.esm.js",
      "types": "./dist/dashboard/index.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools.esm.js",
      "types": "./dist/devtools/index.d.ts"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.5"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/domos/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
