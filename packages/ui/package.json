{
  "name": "@owllayer/ui",
  "version": "0.2.0",
  "description": "OwlLayer AI UI — Embedded dashboard and cross-framework DevTools",
  "type": "module",
  "main": "./dist/ui.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ui.esm.js",
      "types": "./dist/index.d.ts"
    },
    "./dashboard": {
      "import": "./dist/dashboard.esm.js",
      "types": "./dist/dashboard/index.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools.esm.js",
      "types": "./dist/devtools/index.d.ts"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.5"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
