{% comment %}
  OwlLayer Shopify — snippet de développement (Sprint 4)
  Inclure dans theme.liquid juste avant </body> pour tester sur une boutique dev.

  Prérequis :
  - Uploader owllayer-shopify.min.js dans les assets du thème
  - Renseigner les métachamps : owllayer.api_key, owllayer.storefront_token
  - (Optionnel) Pour le suivi de commandes : lire section "Customer access token" ci-dessous
{% endcomment %}

{% comment %} Données produit disponibles uniquement sur les pages produit {% endcomment %}
{% if product %}
<script id="owllayer-product-json" type="application/json">
  {{ product | json }}
</script>
{% endif %}

{% comment %} Données collection disponibles uniquement sur les pages collection {% endcomment %}
{% if collection %}
<script id="owllayer-collection-json" type="application/json">
  {{ collection | json }}
</script>
{% endif %}

{% comment %}
  Customer access token — Sprint 4
  Requis pour que get_order_status retourne les vraies données de commande.
  Sans ce bloc, l'outil redirige l'utilisateur vers /account/orders.
{% endcomment %}
{% if customer %}
<script>window.__owllayer_customer_token = {{ customer.access_token | json }};</script>
{% endif %}

{% comment %} SDK OwlLayer Browser (base) {% endcomment %}
<script src="https://cdn.owllayer.dev/browser@latest/owllayer.min.js" defer></script>

{% comment %} SDK OwlLayer Shopify (ce package, uploadé comme asset) {% endcomment %}
<script src="{{ 'owllayer-shopify.min.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    OwlLayerShopify.init({
      apiKey: {{ shop.metafields.owllayer.api_key | json }},
      storefrontToken: {{ shop.metafields.owllayer.storefront_token | json }},
      shopDomain: {{ shop.permanent_domain | json }},
      features: {
        orderTracking: {% if customer %}true{% else %}false{% endif %},
      },
      widget: {
        agentName: 'OwlLayer Shopify',
      },
    });
  });
</script>
