{
  "name": "@owllayer/shopify",
  "version": "0.1.0",
  "description": "OwlLayer Shopify Package — Native Shopify integration built on @owllayer/browser",
  "type": "module",
  "main": "./dist/owllayer-shopify.bundle.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/owllayer-shopify.bundle.mjs",
      "types": "./dist/index.d.ts"
    },
    "./cdn": "./dist/owllayer-shopify.min.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/browser": "workspace:*",
    "@owllayer/core": "workspace:*",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "license": "UNLICENSED",
  "private": true
}
