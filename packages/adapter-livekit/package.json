{
  "name": "@owllayer/adapter-livekit",
  "version": "0.3.0",
  "description": "OwlLayer Adapter - LiveKit optional runtime foundation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^",
    "@livekit/agents": "1.9.0",
    "@livekit/agents-plugin-google": "1.9.0",
    "@livekit/rtc-node": "0.13.35",
    "livekit-server-sdk": "2.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "owllayer",
    "ai-agents",
    "livekit",
    "voice-ai",
    "realtime",
    "mcp",
    "model-context-protocol",
    "webmcp",
    "native-mcp",
    "tool-calling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/adapter-livekit"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
