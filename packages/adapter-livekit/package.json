{
  "name": "@domos/adapter-livekit",
  "version": "0.1.0",
  "description": "DomOS Adapter - LiveKit optional runtime foundation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@domos/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
