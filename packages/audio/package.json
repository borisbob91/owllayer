{
  "name": "@domos/audio",
  "version": "0.1.1",
  "description": "Temporary compatibility shim for the OwlLayer AI Core Media audio utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm --filter @owllayer/core build && tsup src/index.ts --format esm --dts --clean --external @owllayer/core",
    "dev": "pnpm --filter @owllayer/core build && tsup src/index.ts --format esm --dts --watch --external @owllayer/core",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/audio"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/domos/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
