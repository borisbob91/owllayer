{
  "name": "@domos/svelte",
  "version": "0.1.0",
  "description": "DomOS Svelte SDK - Stores et Actions pour UI Agentique",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external svelte --external @domos/core --external zod --external @domos/ui",
    "dev": "tsup src/index.ts --format esm --dts --watch --external svelte --external @domos/core --external zod",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@domos/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "svelte": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": { "url": "https://github.com/borisbob91/domos/issues" },
  "publishConfig": { "access": "public" }
}
