{
  "name": "@owllayer/vue",
  "version": "0.3.0",
  "description": "OwlLayer Vue SDK - Composables et Plugin pour UI Agentique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external vue --external @owllayer/core --external zod --external @owllayer/ui --external @owllayer/ui --loader .vue=copy",
    "dev": "tsup src/index.ts --format esm --dts --watch --external vue --external @owllayer/core --external zod --loader .vue=copy",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@owllayer/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@owllayer/ui": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
