{
  "name": "@domos/vue",
  "version": "0.1.0",
  "description": "DomOS Vue SDK - Composables et Plugin pour UI Agentique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external vue --external @domos/core --external zod --loader .vue=copy",
    "dev": "tsup src/index.ts --format esm --dts --watch --external vue --external @domos/core --external zod --loader .vue=copy"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.0"
  }
}
