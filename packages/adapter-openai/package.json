{
  "name": "@owllayer/adapter-openai",
  "version": "0.2.0",
  "description": "OwlLayer Adapter - OpenAI GPT (text + realtime audio)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@owllayer/core": "workspace:*",
    "openai": "^4.86.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/adapter-openai"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
