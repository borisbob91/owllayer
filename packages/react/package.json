{
  "name": "@domos/react",
  "version": "0.1.0",
  "description": "DomOS React SDK - Hooks & Components pour UI Agentique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @domos/ui --external livekit-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "zod": "^3.23"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "livekit-client": "^2.20.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4",
    "@testing-library/react": "^16.0",
    "@testing-library/user-event": "^14.5",
    "@domos/ui": "workspace:*",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "jsdom": "^24.0",
    "livekit-client": "^2.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0",
    "vitest": "^1.6",
    "typescript": "^5.5"
  },
  "files": ["dist"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/domos/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
