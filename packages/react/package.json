{
  "name": "@owllayer/react",
  "version": "0.4.0",
  "description": "OwlLayer React SDK - Hooks & Components pour UI Agentique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @owllayer/ui --external @owllayer/ui --external livekit-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:*",
    "zod": "^3.23"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "livekit-client": "^2.20.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4",
    "@testing-library/react": "^16.0",
    "@testing-library/user-event": "^14.5",
    "@owllayer/ui": "workspace:*",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "jsdom": "^24.0",
    "livekit-client": "^2.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0",
    "vitest": "^1.6",
    "typescript": "^5.5"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "owllayer",
    "react",
    "react-sdk",
    "agentic-ui",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "webmcp",
    "native-mcp",
    "tool-calling",
    "frontend-ai",
    "livekit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
