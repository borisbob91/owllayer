{
  "name": "@domos/react",
  "version": "0.1.0",
  "description": "DomOS React SDK - Hooks & Components pour UI Agentique",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "zod": "^3.23"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0",
    "vitest": "^1.6",
    "typescript": "^5.5"
  },
  "files": ["dist"],
  "license": "MIT"
}
