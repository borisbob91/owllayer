{
  "name": "@domos/core",
  "version": "0.1.0",
  "description": "Temporary compatibility bridge from @domos/core to @owllayer/core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @owllayer/core",
    "test": "node --input-type=module -e \"import('./dist/index.js').then(({ ADTP_VERSION, AITP_VERSION, Messages }) => { if (ADTP_VERSION !== AITP_VERSION || typeof Messages?.handshakeInit !== 'function') throw new Error('Legacy compatibility export validation failed') })\"",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.0",
    "typescript": "^5.5"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/domos.git",
    "directory": "packages/core-legacy"
  },
  "homepage": "https://github.com/borisbob91/domos#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/domos/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
