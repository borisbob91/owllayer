# ═══════════════════════════════════════════════════════
# DomOS Server — Variables d'environnement
# ═══════════════════════════════════════════════════════

# ── Mode ─────────────────────────────────────────────
# DOMOS_MODE=self

# ── Serveur ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── LLM — au moins une clé requise selon llm.provider ──
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Admin Dashboard (requis) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi-imperativement

# ── ElevenLabs (si tts.provider=elevenlabs) ──────────
# ELEVENLABS_API_KEY=

# ── LiveKit optionnel (runtime media / AgentSession) ─
# Ces valeurs restent uniquement côté serveur.
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# Demo token endpoint: origines autorisées, séparées par des virgules.
# Par défaut, le demo-server autorise seulement les origines Vite locales.
# DOMOS_LIVEKIT_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
#
# Provider Gemini via LiveKit Agents.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
