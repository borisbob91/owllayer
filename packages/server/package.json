{
  "name": "@domos/server",
  "version": "0.1.0",
  "description": "DomOS Server - Orchestrateur WebSocket + LLM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external mongodb --external ioredis --external wrtc --external better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@domos/core": "workspace:*",
    "ws": "^8.17.0",
    "zod": "^3.23",
    "webrtc": "^1.0.1",
    "openai": "^4.73.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "tsup": "^8.0",
    "vitest": "^1.6",
    "typescript": "^5.5"
  },
  "files": ["dist"],
  "license": "MIT"
}
