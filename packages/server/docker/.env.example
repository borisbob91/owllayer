# ═══════════════════════════════════════════════════
# DomOS Server — Variables d'environnement
# Copiez ce fichier : cp .env.example .env
# ═══════════════════════════════════════════════════

# Port du serveur
PORT=3000

# Mot de passe admin dashboard (min 16 chars en production)
ADMIN_PASSWORD=changeme-imperativement

# ─── LLM Provider (au moins un requis) ───────────
LLM_PROVIDER=google

# Google Gemini
GOOGLE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# ─── ElevenLabs (optionnel — TTS haute qualité) ──
# ELEVENLABS_API_KEY=

# ─── MongoDB (optionnel — persistance avancée) ───
# MONGO_PASSWORD=changeme
# MONGODB_URI=mongodb://domos:${MONGO_PASSWORD}@mongo:27017/domos
