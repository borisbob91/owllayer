{
  "name": "@owllayer/browser",
  "version": "0.2.0",
  "description": "OwlLayer AI Browser SDK - Universal SDK for non-framework web apps",
  "type": "module",
  "main": "./dist/owllayer.bundle.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/owllayer.bundle.mjs",
      "types": "./dist/index.d.ts"
    },
    "./cdn": "./dist/owllayer.min.js",
    "./core": {
      "import": "./dist/owllayer.core.esm.js",
      "types": "./dist/owllayer.core.d.ts"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owllayer/core": "workspace:*",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.1",
    "typescript": "^5.5",
    "vitest": "^1.6"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbob91/owllayer.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/borisbob91/owllayer#readme",
  "bugs": {
    "url": "https://github.com/borisbob91/owllayer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
