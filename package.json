{
  "name": "owllayer",
  "version": "0.0.0",
  "private": true,
  "description": "OwlLayer - Agentic UI Framework",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/release/sync-sdk-version.mjs",
    "release": "pnpm build:packages && changeset publish",
    "build:packages": "pnpm --filter \"./packages/*\" --filter \"!./packages/shopify\" --filter \"!./packages/woocommerce\" --if-present build",
    "test:packages": "pnpm --filter \"./packages/*\" --filter \"!./packages/shopify\" --filter \"!./packages/woocommerce\" --if-present test",
    "lint:packages": "pnpm --filter \"./packages/*\" --filter \"!./packages/shopify\" --filter \"!./packages/woocommerce\" --if-present lint",
    "verify:packages": "node scripts/release/verify-packages.mjs",
    "docs:dev": "pnpm --filter @owllayer/docs-site dev",
    "docs:build": "pnpm --filter @owllayer/docs-site build",
    "docs:preview": "pnpm --filter @owllayer/docs-site preview"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.0",
    "danger": "^13.0.10",
    "turbo": "^2.0",
    "typescript": "^5.5"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  }
}
