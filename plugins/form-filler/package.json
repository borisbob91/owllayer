{
  "name": "@owllayer-plugins/form-filler",
  "private": true,
  "version": "0.1.0",
  "description": "OwlLayer plugin: AI-driven multi-step form filler with fill_fields, next_step, prev_step, get_state tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@owllayer/core": "workspace:*"
  },
  "peerDependencies": {
    "@owllayer/react": "workspace:*",
    "react": "^18.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@owllayer/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.0.0",
    "vitest": "^1.6"
  }
}
